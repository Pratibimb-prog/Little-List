# Little List — Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Application secret key for signing JWT tokens (generate a strong random secret in production)
SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# JWT Access token expiration time in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database path (optional, defaults to backend/tasks.db)
# DATABASE_PATH=/data/tasks.db

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
